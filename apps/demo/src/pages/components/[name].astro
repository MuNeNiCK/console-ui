---
import ComponentsSidebarLayout from "../../layouts/ComponentsSidebarLayout.astro"
import { components } from "../../lib/components"

export function getStaticPaths() {
  return components.map((component) => ({
    params: { name: component.name },
    props: component,
  }))
}

const component = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/$/, "")
const currentPath = `${base}/components/${component.name}`
const reactInstall = `pnpm dlx shadcn@latest add @console/${component.name}`
const solidInstall = `pnpm dlx shadcn@latest add @console/solid/${component.name}`
---

<ComponentsSidebarLayout title={component.title} currentPath={currentPath}>
  <a href={`${base}/components`} class="text-sm text-muted-foreground hover:text-foreground md:hidden">
    Components
  </a>

  <header class="flex flex-col gap-2">
    <h1 class="text-3xl font-semibold tracking-tight">{component.title}</h1>
    <p class="max-w-2xl text-sm text-muted-foreground">{component.description}</p>
  </header>

  <section class="rounded-lg border bg-card text-card-foreground shadow-sm">
    <div class="flex items-center justify-between border-b px-6 py-4">
      <h2 class="text-lg font-semibold">Preview</h2>
      {component.solid && (
        <div class="flex items-center gap-2" id="framework-toggle">
          <button data-framework="react" class="inline-flex h-8 items-center justify-center rounded-md bg-primary px-3 text-sm font-medium text-primary-foreground">React</button>
          <button data-framework="solid" class="inline-flex h-8 items-center justify-center rounded-md border bg-background px-3 text-sm font-medium text-foreground">Solid</button>
        </div>
      )}
    </div>
    <div class="grid min-h-[320px] place-items-center p-6">
      <div
        id="demo-react"
        class="flex w-full max-w-xl items-center justify-center"
        data-component-preview="react"
        data-component-name={component.name}
      >
      </div>
      {component.solid && (
        <div
          id="demo-solid"
          class="flex w-full max-w-xl items-center justify-center"
          style="display: none;"
          data-component-preview="solid"
          data-component-name={component.name}
        >
        </div>
      )}
    </div>
  </section>

  <section class:list={["grid gap-3", component.solid && "md:grid-cols-2"]}>
    <div class="min-w-0 rounded-lg border bg-card p-6 text-card-foreground shadow-sm">
      <h2 class="font-semibold">React</h2>
      <pre class="mt-3 max-w-full overflow-x-auto rounded bg-secondary p-3 text-xs"><code>{reactInstall}</code></pre>
    </div>
    {component.solid && (
      <div class="min-w-0 rounded-lg border bg-card p-6 text-card-foreground shadow-sm">
        <h2 class="font-semibold">Solid</h2>
        <pre class="mt-3 max-w-full overflow-x-auto rounded bg-secondary p-3 text-xs"><code>{solidInstall}</code></pre>
      </div>
    )}
  </section>
</ComponentsSidebarLayout>

<script>
  import "../../components/component-preview-react"
  import "../../components/component-preview-solid"

  const FRAMEWORK_STORAGE_KEY = "console-ui-framework"
  const toggle = document.getElementById("framework-toggle")
  const reactDemo = document.getElementById("demo-react")
  const solidDemo = document.getElementById("demo-solid")
  const buttons = toggle?.querySelectorAll("button") ?? []

  function setFramework(framework, persist = true) {
    const isReact = framework === "react"
    if (reactDemo) reactDemo.style.display = isReact ? "" : "none"
    if (solidDemo) solidDemo.style.display = isReact ? "none" : ""
    buttons.forEach((button) => {
      const active = button.dataset.framework === framework
      button.className = [
        "inline-flex h-8 items-center justify-center rounded-md px-3 text-sm font-medium",
        active
          ? "bg-primary text-primary-foreground"
          : "border bg-background text-foreground",
      ].join(" ")
    })

    if (persist) localStorage.setItem(FRAMEWORK_STORAGE_KEY, framework)
  }

  const savedFramework = localStorage.getItem(FRAMEWORK_STORAGE_KEY)
  setFramework(savedFramework === "solid" && solidDemo ? "solid" : "react", false)

  buttons.forEach((button) => {
    button.addEventListener("click", () => setFramework(button.dataset.framework || "react"))
  })
</script>
