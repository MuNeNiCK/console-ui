---
import Layout from "../../layouts/Layout.astro"
import { components } from "../../lib/components"
import ReactDemo from "../../components/react-demo"
import SolidDemo from "../../components/solid-demo"

export function getStaticPaths() {
  return components.map((component) => ({
    params: { name: component.name },
    props: component,
  }))
}

const component = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/$/, "")
const reactInstall = `pnpm dlx shadcn@latest add @console/${component.name}`
const solidInstall = `pnpm dlx shadcn@latest add @console/solid/${component.name}`
---

<Layout title={component.title}>
  <main class="mx-auto flex min-h-svh max-w-5xl flex-col gap-6 px-6 py-10">
    <a href={`${base}/components`} class="text-sm text-muted-foreground hover:text-foreground">Components</a>
    <header class="flex flex-col gap-2">
      <p class="font-mono text-[11px] uppercase tracking-[0.24em] text-muted-foreground">console primitive</p>
      <h1 class="text-3xl font-semibold tracking-tight">{component.title}</h1>
      <p class="max-w-2xl text-sm text-muted-foreground">{component.description}</p>
    </header>

    <section class="rounded border border-border bg-card">
      <div class="flex items-center justify-between border-b border-border px-4 py-3">
        <h2 class="font-mono text-[11px] uppercase tracking-[0.2em] text-muted-foreground">Preview</h2>
        <div class="flex items-center gap-2" id="framework-toggle">
          <button data-framework="react" class="rounded border border-primary bg-primary px-3 py-1.5 font-mono text-[10px] uppercase tracking-[0.18em] text-primary-foreground">React</button>
          <button data-framework="solid" class="rounded border border-border bg-muted px-3 py-1.5 font-mono text-[10px] uppercase tracking-[0.18em] text-muted-foreground">Solid</button>
        </div>
      </div>
      <div class="grid min-h-[320px] place-items-center p-6">
        <div id="demo-react">
          <ReactDemo name={component.name} client:only="react" />
        </div>
        <div id="demo-solid" style="display: none;">
          <SolidDemo name={component.name} client:only="solid-js" />
        </div>
      </div>
    </section>

    <section class="grid gap-3 md:grid-cols-2">
      <div class="rounded border border-border bg-card p-4">
        <h2 class="font-mono text-[11px] uppercase tracking-[0.2em] text-muted-foreground">React</h2>
        <pre class="mt-3 overflow-x-auto rounded bg-muted p-3 text-xs"><code>{reactInstall}</code></pre>
      </div>
      <div class="rounded border border-border bg-card p-4">
        <h2 class="font-mono text-[11px] uppercase tracking-[0.2em] text-muted-foreground">Solid</h2>
        <pre class="mt-3 overflow-x-auto rounded bg-muted p-3 text-xs"><code>{solidInstall}</code></pre>
      </div>
    </section>
  </main>
</Layout>

<script>
  const toggle = document.getElementById("framework-toggle")
  const reactDemo = document.getElementById("demo-react")
  const solidDemo = document.getElementById("demo-solid")
  const buttons = toggle?.querySelectorAll("button") ?? []

  function setFramework(framework) {
    const isReact = framework === "react"
    if (reactDemo) reactDemo.style.display = isReact ? "" : "none"
    if (solidDemo) solidDemo.style.display = isReact ? "none" : ""
    buttons.forEach((button) => {
      const active = button.dataset.framework === framework
      button.className = [
        "rounded border px-3 py-1.5 font-mono text-[10px] uppercase tracking-[0.18em]",
        active
          ? "border-primary bg-primary text-primary-foreground"
          : "border-border bg-muted text-muted-foreground",
      ].join(" ")
    })
  }

  buttons.forEach((button) => {
    button.addEventListener("click", () => setFramework(button.dataset.framework || "react"))
  })
</script>
