---
import { ClientRouter } from "astro:transitions"
import "../styles/globals.css"

interface Props {
  title: string
}

const { title } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} - Console UI</title>
    <ClientRouter />
    <script is:inline>
      const theme = localStorage.getItem("console-ui-theme")
      document.documentElement.classList.toggle(
        "dark",
        theme === "dark"
      )
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
