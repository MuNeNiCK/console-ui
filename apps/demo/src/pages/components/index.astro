---
import ComponentsSidebarLayout from "../../layouts/ComponentsSidebarLayout.astro"
import { components } from "../../lib/components"

const base = import.meta.env.BASE_URL.replace(/\/$/, "")
const currentPath = `${base}/components`
---

<ComponentsSidebarLayout title="Components" currentPath={currentPath}>
  <header class="space-y-2">
    <h1 class="text-3xl font-semibold tracking-tight">Components</h1>
    <p class="text-sm text-muted-foreground">
      Browse the available registry components.
    </p>
  </header>
  <div class="grid gap-3 sm:grid-cols-2">
    {components.map((component) => (
      <a class="rounded-lg border bg-card p-6 text-card-foreground shadow-sm transition-colors hover:bg-accent hover:text-accent-foreground" href={`${base}/components/${component.name}`}>
        <div class="flex items-center justify-between gap-3">
          <h2 class="font-medium">{component.title}</h2>
          <span class="text-sm text-muted-foreground">
            {component.solid ? "React + Solid" : "React"}
          </span>
        </div>
        <p class="mt-2 text-sm text-muted-foreground">{component.description}</p>
      </a>
    ))}
  </div>
</ComponentsSidebarLayout>
