---
import Layout from "../layouts/Layout.astro"
import { components } from "../lib/components"

const base = import.meta.env.BASE_URL.replace(/\/$/, "")
---

<Layout title="Home">
  <main class="mx-auto flex min-h-svh max-w-5xl flex-col gap-8 px-6 py-10">
    <header class="flex flex-col gap-4">
      <div>
        <p class="font-mono text-[11px] uppercase tracking-[0.24em] text-muted-foreground">
          console-ui registry
        </p>
        <h1 class="mt-2 text-4xl font-semibold tracking-tight">
          shadcn components for infrastructure consoles
        </h1>
      </div>
      <p class="max-w-2xl text-sm leading-6 text-muted-foreground">
        React components start from upstream shadcn/ui. Solid components are implemented to match the React API and visual behavior.
      </p>
      <div class="flex gap-3">
        <a class="inline-flex h-9 items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground" href={`${base}/components`}>
          Browse components
        </a>
      </div>
    </header>

    <section class="grid gap-3 md:grid-cols-2">
      {components.map((component) => (
        <a class="rounded border border-border bg-card p-4 text-card-foreground transition-colors hover:border-primary" href={`${base}/components/${component.name}`}>
          <h2 class="font-medium">{component.title}</h2>
          <p class="mt-2 text-sm text-muted-foreground">{component.description}</p>
        </a>
      ))}
    </section>
  </main>
</Layout>
