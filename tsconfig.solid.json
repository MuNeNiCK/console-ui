{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "types": [],
    "paths": {
      "@/components/blocks/*": ["./registry/solid/blocks/*"],
      "@/components/layouts/*": ["./registry/solid/blocks/resource/layouts/*"],
      "@/components/ui/*": ["./registry/solid/ui/*"],
      "@/components/*": ["./registry/solid/blocks/resource/*"],
      "@/hooks/*": ["./registry/solid/hooks/*"],
      "@/lib/*": ["./registry/solid/lib/*"],
      "@/*": ["./*"]
    }
  },
  "include": ["registry/solid/**/*.ts", "registry/solid/**/*.tsx"],
  "exclude": ["node_modules", "public/r"]
}
